<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Círculos e Elipses · Rasterização</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #1a1a2e;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #eee;
        }
        .container {
            background: #16213e;
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            text-align: center;
            max-width: 950px;
        }
        h1 {
            font-size: 1.5rem;
            font-weight: 400;
            letter-spacing: 1px;
            margin-bottom: 8px;
            color: #e0e0e0;
        }
        h1 span {
            color: #f39c12;
            font-weight: 600;
        }
        .subtitle {
            font-size: 0.85rem;
            color: #888;
            margin-bottom: 15px;
        }

        /* Layout principal: Imagens | Parâmetros */
        .main-layout {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
        }

        /* Área de Imagens (canvas) */
        .canvas-wrapper {
            flex: 1;
            min-width: 400px;
            background: #0f0f1f;
            border: 2px solid #2c3e6b;
            border-radius: 10px;
            padding: 5px;
            box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.7);
        }
        .canvas-wrapper .canvas-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 4px 10px;
            background: #1a1a3a;
            border-radius: 6px 6px 0 0;
            border-bottom: 1px solid #2c3e6b;
        }
        .canvas-wrapper .canvas-header span {
            font-size: 0.7rem;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .canvas-wrapper .canvas-header .badge {
            background: #2c3e6b;
            padding: 2px 10px;
            border-radius: 10px;
            font-size: 0.6rem;
            color: #aaa;
        }
        .canvas-wrapper .canvas-header .badge .count {
            color: #f39c12;
            font-weight: 600;
        }
        canvas {
            display: block;
            width: 100%;
            height: auto;
            aspect-ratio: 400/400;
            background: #0f0f1f;
            cursor: crosshair;
            border-radius: 0 0 8px 8px;
            image-rendering: crisp-edges;
            image-rendering: pixelated;
        }

        /* Área de Parâmetros (sidebar) */
        .sidebar {
            background: #1a1a3a;
            padding: 16px 18px;
            border-radius: 10px;
            border: 1px solid #2a2a5a;
            min-width: 200px;
            flex: 0 0 250px;
            text-align: left;
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: 520px;
        }
        .sidebar .section-title {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #666;
            border-bottom: 1px solid #2a2a5a;
            padding-bottom: 4px;
            text-align: center;
            margin-bottom: 4px;
            flex-shrink: 0;
        }
        .sidebar .param-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex-shrink: 0;
        }
        .sidebar .param-group label {
            font-size: 0.72rem;
            color: #aaa;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .sidebar .param-group label .label-text {
            color: #888;
        }
        .sidebar .param-group label .value-display {
            color: #f39c12;
            font-weight: 600;
            font-size: 0.75rem;
            min-width: 35px;
            text-align: right;
        }
        .sidebar .param-group .param-row {
            display: flex;
            gap: 6px;
            align-items: center;
        }
        .sidebar .param-group .param-row span {
            font-size: 0.72rem;
            color: #888;
            min-width: 14px;
        }
        .sidebar .param-group .param-row input[type="number"] {
            flex: 1;
            padding: 4px 6px;
            border-radius: 4px;
            border: none;
            background: #2a2a4a;
            color: #fff;
            font-weight: 600;
            text-align: center;
            font-size: 0.8rem;
            min-width: 40px;
        }
        .sidebar .param-group .radio-group {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 2px;
        }
        .sidebar .param-group .radio-group label {
            font-size: 0.78rem;
            color: #ccc;
            display: flex;
            align-items: center;
            gap: 4px;
            cursor: pointer;
        }
        .sidebar .param-group .radio-group label input[type="radio"] {
            accent-color: #f39c12;
            cursor: pointer;
        }

        .sidebar .btn-group {
            display: flex;
            gap: 4px;
            flex-wrap: wrap;
            flex-shrink: 0;
        }
        .sidebar .btn-group .btn {
            flex: 1;
            min-width: 45px;
            padding: 5px 8px;
            border: none;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.62rem;
            cursor: pointer;
            transition: all 0.2s;
            letter-spacing: 0.3px;
            box-shadow: 0 2px 0 #0a0a1a;
            color: #fff;
            text-align: center;
        }
        .sidebar .btn-group .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 0 #0a0a1a;
        }
        .sidebar .btn-group .btn:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 #0a0a1a;
        }
        .btn-warning { background: #d35400; }
        .btn-warning:hover { background: #e67e22; }
        .btn-success { background: #27ae60; }
        .btn-success:hover { background: #2ecc71; }
        .btn-danger { background: #c0392b; }
        .btn-danger:hover { background: #e74c3c; }
        .btn-primary { background: #2980b9; }
        .btn-primary:hover { background: #3498db; }
        .btn-secondary { background: #2a2a5a; }
        .btn-secondary:hover { background: #3d3d7a; }
        .btn-small { font-size: 0.58rem; padding: 3px 8px; }

        /* Legendas */
        .legend {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 4px;
            font-size: 0.6rem;
            flex-wrap: wrap;
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }
        .legend-color {
            width: 16px;
            height: 2px;
            border-radius: 2px;
        }

        /* Info line */
        .info-line {
            display: flex;
            justify-content: space-between;
            font-size: 0.65rem;
            color: #888;
            background: #0d0d1f;
            padding: 4px 12px;
            border-radius: 12px;
            border: 1px solid #2a2a4a;
            flex-shrink: 0;
        }
        .info-line span { color: #aaa; }
        .info-line .val { color: #f39c12; font-weight: 600; }

        .status-msg {
            font-size: 0.65rem;
            color: #888;
            background: #0d0d1f;
            padding: 3px 10px;
            border-radius: 12px;
            text-align: center;
            border: 1px solid #2a2a4a;
            flex-shrink: 0;
        }
        .status-msg .highlight { color: #f39c12; }

        @media (max-width: 780px) {
            .main-layout { flex-direction: column; }
            .canvas-wrapper { min-width: unset; }
            .sidebar { flex: 1; min-width: unset; max-height: none; }
        }
    </style>
</head>
<body>

<div class="container">
    <h1>⭕ Círculos & Elipses — <span>Rasterização</span></h1>
    <div class="subtitle">Síntese e Processamento de Imagem · Algoritmo do Ponto Médio</div>

    <!-- Layout: Imagens | Parâmetros -->
    <div class="main-layout">
        <!-- Área de Imagens -->
        <div class="canvas-wrapper">
            <div class="canvas-header">
                <span>📐 Círculos e Elipses</span>
                <span class="badge">Forma: <span class="count" id="badgeShape">Círculo</span></span>
            </div>
            <canvas id="canvas" width="400" height="400"></canvas>

            <div class="legend">
                <div class="legend-item"><span class="legend-color" style="background: #1a2633;"></span> Contorno</div>
                <div class="legend-item"><span class="legend-dot" style="background: #d73a3a;"></span> Centro</div>
                <div class="legend-item"><span class="legend-dot" style="background: #f39c12; width: 5px; height: 5px;"></span> Pixel</div>
            </div>
        </div>

        <!-- Área de Parâmetros -->
        <div class="sidebar">
            <div class="section-title">⚙️ Parâmetros</div>

            <div class="param-group">
                <label><span class="label-text">📍 Centro</span></label>
                <div class="param-row">
                    <span>X</span>
                    <input type="number" id="cx" value="200" min="0" max="399" step="1">
                    <span>Y</span>
                    <input type="number" id="cy" value="200" min="0" max="399" step="1">
                </div>
            </div>

            <div class="param-group">
                <label><span class="label-text">📏 Raio / Eixos</span></label>
                <div class="param-row">
                    <span>Rx</span>
                    <input type="number" id="rx" value="120" min="1" max="250" step="1">
                    <span>Ry</span>
                    <input type="number" id="ry" value="80" min="1" max="250" step="1">
                </div>
            </div>

            <div class="param-group">
                <label><span class="label-text">🎯 Tipo</span></label>
                <div class="radio-group">
                    <label><input type="radio" name="shape" value="circle" checked> Círculo</label>
                    <label><input type="radio" name="shape" value="ellipse"> Elipse</label>
                </div>
            </div>

            <div class="param-group">
                <label>
                    <span class="label-text">🎨 Cor do Contorno</span>
                </label>
                <input type="color" id="shapeColor" value="#1a2633" style="width:100%;padding:2px;background:#2a2a4a;border:none;border-radius:4px;cursor:pointer;">
            </div>

            <div class="btn-group" style="flex-shrink:0;">
                <button class="btn btn-primary" id="drawBtn">🔄 Desenhar</button>
                <button class="btn btn-warning" id="randomBtn">🎲 Aleatório</button>
                <button class="btn btn-secondary" id="resetBtn">↺ Reset</button>
            </div>

            <div class="info-line">
                <span>📐 <span class="val" id="shapeLabel">Círculo</span></span>
                <span>📏 <span class="val" id="radiusLabel">r = 120</span></span>
            </div>

            <div class="status-msg" id="statusMsg">🖱️ Clique no canvas para definir o centro</div>
        </div>
    </div>
</div>

<script>
    (function() {
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');

        // inputs
        const cxInput = document.getElementById('cx');
        const cyInput = document.getElementById('cy');
        const rxInput = document.getElementById('rx');
        const ryInput = document.getElementById('ry');
        const shapeRadios = document.querySelectorAll('input[name="shape"]');
        const shapeColorInput = document.getElementById('shapeColor');
        const drawBtn = document.getElementById('drawBtn');
        const randomBtn = document.getElementById('randomBtn');
        const resetBtn = document.getElementById('resetBtn');
        const shapeLabel = document.getElementById('shapeLabel');
        const radiusLabel = document.getElementById('radiusLabel');
        const badgeShape = document.getElementById('badgeShape');
        const statusMsg = document.getElementById('statusMsg');

        let corContorno = '#1a2633';

        // ---- rasterização ----
        function putPixel(x, y, color = corContorno) {
            if (x < 0 || x >= 400 || y < 0 || y >= 400) return;
            const imageData = ctx.getImageData(0, 0, 400, 400);
            const data = imageData.data;
            const index = (y * 400 + x) * 4;
            if (index >= 0 && index < data.length) {
                const r = parseInt(color.slice(1,3), 16);
                const g = parseInt(color.slice(3,5), 16);
                const b = parseInt(color.slice(5,7), 16);
                data[index] = r;
                data[index+1] = g;
                data[index+2] = b;
                data[index+3] = 255;
                ctx.putImageData(imageData, 0, 0);
            }
        }

        function clearCanvas() {
            ctx.fillStyle = '#0f0f1f';
            ctx.fillRect(0, 0, 400, 400);
            ctx.strokeStyle = '#1a1a3a';
            ctx.lineWidth = 0.5;
            for (let i = 0; i <= 400; i += 40) {
                ctx.beginPath();
                ctx.moveTo(i, 0);
                ctx.lineTo(i, 400);
                ctx.stroke();
                ctx.beginPath();
                ctx.moveTo(0, i);
                ctx.lineTo(400, i);
                ctx.stroke();
            }
        }

        // ---- círculo (ponto médio) ----
        function drawCircle(xc, yc, radius, color = corContorno) {
            if (radius < 1) return;
            let x = 0;
            let y = radius;
            let p = 1 - radius;

            while (x <= y) {
                putPixel(xc + x, yc + y, color);
                putPixel(xc - x, yc + y, color);
                putPixel(xc + x, yc - y, color);
                putPixel(xc - x, yc - y, color);
                putPixel(xc + y, yc + x, color);
                putPixel(xc - y, yc + x, color);
                putPixel(xc + y, yc - x, color);
                putPixel(xc - y, yc - x, color);

                if (p < 0) {
                    p += 2 * x + 3;
                } else {
                    p += 2 * (x - y) + 5;
                    y--;
                }
                x++;
            }
        }

        // ---- elipse (ponto médio adaptado) ----
        function drawEllipse(xc, yc, rx, ry, color = corContorno) {
            if (rx < 1 || ry < 1) return;
            let x = 0;
            let y = ry;
            let rx2 = rx * rx;
            let ry2 = ry * ry;
            let twoRx2 = 2 * rx2;
            let twoRy2 = 2 * ry2;
            let p = Math.round(ry2 - rx2 * ry + 0.25 * rx2);
            
            while (twoRy2 * x <= twoRx2 * y) {
                putPixel(xc + x, yc + y, color);
                putPixel(xc - x, yc + y, color);
                putPixel(xc + x, yc - y, color);
                putPixel(xc - x, yc - y, color);

                if (p < 0) {
                    x++;
                    p += twoRy2 * x + ry2;
                } else {
                    x++;
                    y--;
                    p += twoRy2 * x - twoRx2 * y + ry2;
                }
            }

            p = Math.round(ry2 * (x + 0.5) * (x + 0.5) + rx2 * (y - 1) * (y - 1) - rx2 * ry2);
            while (y > 0) {
                putPixel(xc + x, yc + y, color);
                putPixel(xc - x, yc + y, color);
                putPixel(xc + x, yc - y, color);
                putPixel(xc - x, yc - y, color);

                if (p > 0) {
                    y--;
                    p -= twoRx2 * y + rx2;
                } else {
                    x++;
                    y--;
                    p += twoRy2 * x - twoRx2 * y + rx2;
                }
            }
        }

        // ---- desenhar ----
        function draw() {
            clearCanvas();

            const cx = parseInt(cxInput.value, 10) || 200;
            const cy = parseInt(cyInput.value, 10) || 200;
            let rx = parseInt(rxInput.value, 10) || 80;
            let ry = parseInt(ryInput.value, 10) || 60;

            // Validação
            const validar = (v, min, max, def) => {
                if (isNaN(v) || v < min) return def;
                if (v > max) return max;
                return v;
            };
            const cxVal = validar(cx, 0, 399, 200);
            const cyVal = validar(cy, 0, 399, 200);
            const rxVal = validar(rx, 1, 250, 80);
            const ryVal = validar(ry, 1, 250, 60);

            cxInput.value = cxVal;
            cyInput.value = cyVal;
            rxInput.value = rxVal;
            ryInput.value = ryVal;

            const isCircle = document.querySelector('input[name="shape"]:checked').value === 'circle';
            const color = corContorno;

            if (isCircle) {
                const radius = Math.min(rxVal, ryVal);
                drawCircle(cxVal, cyVal, radius, color);
                shapeLabel.textContent = 'Círculo';
                radiusLabel.textContent = `r = ${radius}`;
                badgeShape.textContent = 'Círculo';
                rxInput.value = radius;
                ryInput.value = radius;
                statusMsg.innerHTML = `⭕ Círculo desenhado em (${cxVal}, ${cyVal}) com raio ${radius}`;
            } else {
                drawEllipse(cxVal, cyVal, rxVal, ryVal, color);
                shapeLabel.textContent = 'Elipse';
                radiusLabel.textContent = `Rx=${rxVal}  Ry=${ryVal}`;
                badgeShape.textContent = 'Elipse';
                statusMsg.innerHTML = `🟠 Elipse desenhada em (${cxVal}, ${cyVal}) com Rx=${rxVal}, Ry=${ryVal}`;
            }

            // Marcar centro com vermelho
            putPixel(cxVal, cyVal, '#d73a3a');
            // Círculo ao redor do centro
            for (let d = -2; d <= 2; d++) {
                putPixel(cxVal + d, cyVal, '#d73a3a');
                putPixel(cxVal, cyVal + d, '#d73a3a');
            }
        }

        // ---- aleatório ----
        function randomizar() {
            cxInput.value = Math.floor(Math.random() * 380) + 10;
            cyInput.value = Math.floor(Math.random() * 380) + 10;
            rxInput.value = Math.floor(Math.random() * 150) + 20;
            ryInput.value = Math.floor(Math.random() * 150) + 20;
            const isCircle = Math.random() > 0.5;
            document.querySelector('input[name="shape"][value="' + (isCircle ? 'circle' : 'ellipse') + '"]').checked = true;
            draw();
            statusMsg.innerHTML = `🎲 Forma aleatória <span style="color:#2ecc71;">gerada</span>!`;
        }

        // ---- reset ----
        function resetar() {
            cxInput.value = 200;
            cyInput.value = 200;
            rxInput.value = 120;
            ryInput.value = 80;
            document.querySelector('input[name="shape"][value="circle"]').checked = true;
            draw();
            statusMsg.innerHTML = '↺ Parâmetros <span style="color:#2ecc71;">resetados</span> para o padrão';
        }

        // ---- eventos ----
        drawBtn.addEventListener('click', draw);
        randomBtn.addEventListener('click', randomizar);
        resetBtn.addEventListener('click', resetar);

        shapeColorInput.addEventListener('input', () => {
            corContorno = shapeColorInput.value;
            draw();
        });

        [cxInput, cyInput, rxInput, ryInput].forEach(input => {
            input.addEventListener('input', draw);
        });

        shapeRadios.forEach(radio => {
            radio.addEventListener('change', draw);
        });

        // Clique no canvas define o centro
        canvas.addEventListener('click', (e) => {
            const rect = canvas.getBoundingClientRect();
            const scaleX = canvas.width / rect.width;
            const scaleY = canvas.height / rect.height;
            const mouseX = Math.round((e.clientX - rect.left) * scaleX);
            const mouseY = Math.round((e.clientY - rect.top) * scaleY);
            if (mouseX >= 0 && mouseX < 400 && mouseY >= 0 && mouseY < 400) {
                cxInput.value = mouseX;
                cyInput.value = mouseY;
                draw();
                statusMsg.innerHTML = `📍 Centro movido para (${mouseX}, ${mouseY})`;
            }
        });

        // Inicialização
        draw();
        statusMsg.innerHTML = '🖱️ Clique no canvas para definir o centro';

        window.__state = { cx: cxInput, cy: cyInput, rx: rxInput, ry: ryInput };
    })();
</script>

</body>
</html>
