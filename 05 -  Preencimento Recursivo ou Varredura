<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Preenchimento · Varredura e Recursivo</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #1a1a2e;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #eee;
        }
        .container {
            background: #16213e;
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            text-align: center;
            max-width: 950px;
        }
        h1 {
            font-size: 1.5rem;
            font-weight: 400;
            letter-spacing: 1px;
            margin-bottom: 8px;
            color: #e0e0e0;
        }
        h1 span {
            color: #3498db;
            font-weight: 600;
        }
        .subtitle {
            font-size: 0.85rem;
            color: #888;
            margin-bottom: 15px;
        }

        /* Layout principal: Imagens | Parâmetros */
        .main-layout {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
        }

        /* Área de Imagens (canvas) */
        .canvas-wrapper {
            flex: 1;
            min-width: 400px;
            background: #0f0f1f;
            border: 2px solid #2c3e6b;
            border-radius: 10px;
            padding: 5px;
            box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.7);
        }
        .canvas-wrapper .canvas-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 4px 10px;
            background: #1a1a3a;
            border-radius: 6px 6px 0 0;
            border-bottom: 1px solid #2c3e6b;
        }
        .canvas-wrapper .canvas-header span {
            font-size: 0.7rem;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .canvas-wrapper .canvas-header .badge {
            background: #2c3e6b;
            padding: 2px 10px;
            border-radius: 10px;
            font-size: 0.6rem;
            color: #aaa;
        }
        .canvas-wrapper .canvas-header .badge .count {
            color: #3498db;
            font-weight: 600;
        }
        canvas {
            display: block;
            width: 100%;
            height: auto;
            aspect-ratio: 400/400;
            background: #0f0f1f;
            cursor: crosshair;
            border-radius: 0 0 8px 8px;
            image-rendering: crisp-edges;
            image-rendering: pixelated;
        }

        /* Área de Parâmetros (sidebar) */
        .sidebar {
            background: #1a1a3a;
            padding: 16px 18px;
            border-radius: 10px;
            border: 1px solid #2a2a5a;
            min-width: 200px;
            flex: 0 0 250px;
            text-align: left;
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: 540px;
        }
        .sidebar .section-title {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #666;
            border-bottom: 1px solid #2a2a5a;
            padding-bottom: 4px;
            text-align: center;
            margin-bottom: 4px;
            flex-shrink: 0;
        }
        .sidebar .param-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex-shrink: 0;
        }
        .sidebar .param-group label {
            font-size: 0.72rem;
            color: #aaa;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .sidebar .param-group label .label-text {
            color: #888;
        }
        .sidebar .param-group .radio-group {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }
        .sidebar .param-group .radio-group label {
            font-size: 0.78rem;
            color: #ccc;
            display: flex;
            align-items: center;
            gap: 4px;
            cursor: pointer;
        }
        .sidebar .param-group .radio-group label input[type="radio"] {
            accent-color: #3498db;
            cursor: pointer;
        }
        .sidebar .param-group input[type="number"] {
            width: 100%;
            padding: 4px 8px;
            border-radius: 4px;
            border: none;
            background: #2a2a4a;
            color: #fff;
            font-weight: 600;
            text-align: center;
            font-size: 0.8rem;
        }
        .sidebar .param-group .seed-row {
            display: flex;
            gap: 6px;
            align-items: center;
        }
        .sidebar .param-group .seed-row input[type="number"] {
            width: 60px;
            padding: 3px 6px;
        }
        .sidebar .param-group .seed-row span {
            font-size: 0.72rem;
            color: #888;
        }

        .sidebar .btn-group {
            display: flex;
            gap: 4px;
            flex-wrap: wrap;
            flex-shrink: 0;
        }
        .sidebar .btn-group .btn {
            flex: 1;
            min-width: 45px;
            padding: 5px 8px;
            border: none;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.62rem;
            cursor: pointer;
            transition: all 0.2s;
            letter-spacing: 0.3px;
            box-shadow: 0 2px 0 #0a0a1a;
            color: #fff;
            text-align: center;
        }
        .sidebar .btn-group .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 0 #0a0a1a;
        }
        .sidebar .btn-group .btn:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 #0a0a1a;
        }
        .btn-warning { background: #d35400; }
        .btn-warning:hover { background: #e67e22; }
        .btn-success { background: #27ae60; }
        .btn-success:hover { background: #2ecc71; }
        .btn-danger { background: #c0392b; }
        .btn-danger:hover { background: #e74c3c; }
        .btn-primary { background: #2980b9; }
        .btn-primary:hover { background: #3498db; }
        .btn-secondary { background: #2a2a5a; }
        .btn-secondary:hover { background: #3d3d7a; }
        .btn-purple { background: #6c3483; }
        .btn-purple:hover { background: #8e44ad; }
        .btn-small { font-size: 0.58rem; padding: 3px 8px; }

        /* Lista de vértices */
        .points-scroll {
            flex: 1;
            overflow-y: auto;
            padding-right: 4px;
            margin: 4px 0;
            min-height: 60px;
            max-height: 120px;
        }
        .points-scroll::-webkit-scrollbar { width: 4px; }
        .points-scroll::-webkit-scrollbar-thumb { background: #2a2a4a; border-radius: 10px; }
        .point-item {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 2px 6px;
            border-radius: 4px;
            background: #12122a;
            margin-bottom: 2px;
            font-size: 0.65rem;
        }
        .point-item .idx {
            font-weight: 600;
            color: #3498db;
            min-width: 20px;
            font-size: 0.6rem;
        }
        .point-item input[type="number"] {
            width: 35px;
            padding: 1px 3px;
            border: 1px solid #2a2a4a;
            border-radius: 3px;
            background: #1a1a3a;
            color: #fff;
            font-size: 0.6rem;
            text-align: center;
        }
        .point-item .btn-remove {
            background: none;
            border: none;
            color: #e74c3c;
            cursor: pointer;
            font-weight: bold;
            font-size: 0.7rem;
            padding: 0 2px;
        }
        .point-item .btn-remove:hover { color: #ff6b6b; }

        .status-msg {
            font-size: 0.65rem;
            color: #888;
            background: #0d0d1f;
            padding: 3px 10px;
            border-radius: 12px;
            text-align: center;
            border: 1px solid #2a2a4a;
            flex-shrink: 0;
        }
        .status-msg .highlight { color: #3498db; }

        /* Legendas */
        .legend {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 4px;
            font-size: 0.6rem;
            flex-wrap: wrap;
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }
        .legend-color {
            width: 16px;
            height: 2px;
            border-radius: 2px;
        }

        /* Info line */
        .info-line {
            display: flex;
            justify-content: space-between;
            font-size: 0.65rem;
            color: #888;
            background: #0d0d1f;
            padding: 4px 12px;
            border-radius: 12px;
            border: 1px solid #2a2a4a;
            flex-shrink: 0;
        }
        .info-line span { color: #aaa; }
        .info-line .val { color: #3498db; font-weight: 600; }

        @media (max-width: 780px) {
            .main-layout { flex-direction: column; }
            .canvas-wrapper { min-width: unset; }
            .sidebar { flex: 1; min-width: unset; max-height: none; }
            .points-scroll { max-height: 80px; }
        }
    </style>
</head>
<body>

<div class="container">
    <h1>🎨 Preenchimento — <span>Varredura · Recursivo</span></h1>
    <div class="subtitle">Síntese e Processamento de Imagem</div>

    <!-- Layout: Imagens | Parâmetros -->
    <div class="main-layout">
        <!-- Área de Imagens -->
        <div class="canvas-wrapper">
            <div class="canvas-header">
                <span>📐 Preenchimento de Polígonos</span>
                <span class="badge">Vértices: <span class="count" id="badgeCount">0</span></span>
            </div>
            <canvas id="canvas" width="400" height="400"></canvas>

            <div class="legend">
                <div class="legend-item"><span class="legend-color" style="background: #2c3e50;"></span> Contorno</div>
                <div class="legend-item"><span class="legend-dot" style="background: #3498db;"></span> Preenchimento</div>
                <div class="legend-item"><span class="legend-dot" style="background: #e74c3c;"></span> Semente</div>
                <div class="legend-item"><span class="legend-dot" style="background: #f39c12; width: 5px; height: 5px;"></span> Vértices</div>
            </div>
        </div>

        <!-- Área de Parâmetros -->
        <div class="sidebar">
            <div class="section-title">⚙️ Parâmetros</div>

            <div class="param-group">
                <label><span class="label-text">🎯 Método</span></label>
                <div class="radio-group">
                    <label><input type="radio" name="method" value="scanline" checked> Varredura</label>
                    <label><input type="radio" name="method" value="recursive"> Recursivo</label>
                </div>
            </div>

            <div class="param-group" id="seedGroup">
                <label><span class="label-text">🌱 Ponto Semente</span></label>
                <div class="seed-row">
                    <span>X</span>
                    <input type="number" id="seedX" value="200" min="0" max="399">
                    <span>Y</span>
                    <input type="number" id="seedY" value="200" min="0" max="399">
                    <button class="btn btn-small btn-warning" id="pickSeedBtn" style="flex:0.5;min-width:40px;">🎯</button>
                </div>
                <div class="status-msg" id="seedStatus">Clique no canvas para definir</div>
            </div>

            <div class="param-group" style="flex-shrink:0;">
                <label><span class="label-text">📐 Polígono (N = <span id="polygonCount">0</span>)</span></label>
                <div class="btn-group">
                    <button class="btn btn-success btn-small" id="addPointBtn">+ Vértice</button>
                    <button class="btn btn-danger btn-small" id="removeLastBtn">- Último</button>
                    <button class="btn btn-secondary btn-small" id="clearPointsBtn">Limpar</button>
                </div>
                <div class="points-scroll" id="pointsList"></div>
            </div>

            <div class="btn-group" style="flex-shrink:0;">
                <button class="btn btn-primary" id="fillBtn">🔄 Preencher</button>
                <button class="btn btn-secondary" id="drawOnlyBtn">✏️ Contorno</button>
                <button class="btn btn-purple" id="randomBtn">🎲 Aleatório</button>
            </div>

            <div class="info-line">
                <span>🔹 Vértices: <span class="val" id="verticesInfo">0</span></span>
                <span>📐 <span class="val" id="methodInfo">Varredura</span></span>
            </div>
        </div>
    </div>
</div>

<script>
    (function() {
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');
        const pointsList = document.getElementById('pointsList');
        const polygonCount = document.getElementById('polygonCount');
        const badgeCount = document.getElementById('badgeCount');
        const verticesInfo = document.getElementById('verticesInfo');
        const methodInfo = document.getElementById('methodInfo');
        const seedStatus = document.getElementById('seedStatus');
        const seedX = document.getElementById('seedX');
        const seedY = document.getElementById('seedY');

        const addPointBtn = document.getElementById('addPointBtn');
        const removeLastBtn = document.getElementById('removeLastBtn');
        const clearPointsBtn = document.getElementById('clearPointsBtn');
        const fillBtn = document.getElementById('fillBtn');
        const drawOnlyBtn = document.getElementById('drawOnlyBtn');
        const pickSeedBtn = document.getElementById('pickSeedBtn');
        const randomBtn = document.getElementById('randomBtn');

        // Estado
        let vertices = [
            { x: 80, y: 340 },
            { x: 60, y: 120 },
            { x: 200, y: 50 },
            { x: 340, y: 140 },
            { x: 300, y: 320 },
            { x: 200, y: 250 }
        ];

        let semente = { x: 200, y: 200 };
        let preenchimentoAtivo = false;

        const corContorno = '#2c3e50';
        const corPreenchimento = '#3498db';
        const corSemente = '#e74c3c';

        // ---- Funções auxiliares ----
        function getVerticesValidos() {
            return vertices.filter(v => v.x >= 0 && v.x < 400 && v.y >= 0 && v.y < 400);
        }

        function getMetodo() {
            return document.querySelector('input[name="method"]:checked').value;
        }

        // ---- Interface ----
        function renderizarLista() {
            const validos = getVerticesValidos();
            let html = '';
            validos.forEach((v, i) => {
                html += `
                    <div class="point-item" data-idx="${i}">
                        <span class="idx">#${i+1}</span>
                        <input type="number" class="pt-x" value="${v.x}" min="0" max="399" step="1">
                        <input type="number" class="pt-y" value="${v.y}" min="0" max="399" step="1">
                        <button class="btn-remove" data-idx="${i}">✕</button>
                    </div>
                `;
            });
            pointsList.innerHTML = html;
            polygonCount.textContent = validos.length;
            badgeCount.textContent = validos.length;
            verticesInfo.textContent = validos.length;

            document.querySelectorAll('.pt-x').forEach((inp, i) => {
                inp.addEventListener('input', () => {
                    const val = parseInt(inp.value, 10);
                    if (!isNaN(val) && val >= 0 && val < 400 && i < vertices.length) {
                        vertices[i].x = val;
                        desenhar(preenchimentoAtivo);
                    }
                });
            });
            document.querySelectorAll('.pt-y').forEach((inp, i) => {
                inp.addEventListener('input', () => {
                    const val = parseInt(inp.value, 10);
                    if (!isNaN(val) && val >= 0 && val < 400 && i < vertices.length) {
                        vertices[i].y = val;
                        desenhar(preenchimentoAtivo);
                    }
                });
            });

            document.querySelectorAll('.btn-remove').forEach(btn => {
                btn.addEventListener('click', () => {
                    const idx = parseInt(btn.dataset.idx, 10);
                    if (vertices.length > 3) {
                        vertices.splice(idx, 1);
                        renderizarLista();
                        desenhar(preenchimentoAtivo);
                    } else {
                        alert('Mínimo de 3 vértices!');
                    }
                });
            });
        }

        // ---- Rasterização (Bresenham) ----
        function putPixel(x, y, cor) {
            if (x < 0 || x >= 400 || y < 0 || y >= 400) return;
            const img = ctx.getImageData(0, 0, 400, 400);
            const d = img.data;
            const idx = (y * 400 + x) * 4;
            const r = parseInt(cor.slice(1,3), 16);
            const g = parseInt(cor.slice(3,5), 16);
            const b = parseInt(cor.slice(5,7), 16);
            d[idx] = r; d[idx+1] = g; d[idx+2] = b; d[idx+3] = 255;
            ctx.putImageData(img, 0, 0);
        }

        function getPixel(x, y) {
            if (x < 0 || x >= 400 || y < 0 || y >= 400) return '#000000';
            const img = ctx.getImageData(0, 0, 400, 400);
            const d = img.data;
            const idx = (y * 400 + x) * 4;
            if (idx >= d.length) return '#000000';
            const r = d[idx], g = d[idx+1], b = d[idx+2];
            return `#${r.toString(16).padStart(2,'0')}${g.toString(16).padStart(2,'0')}${b.toString(16).padStart(2,'0')}`;
        }

        function bresenham(x0, y0, x1, y1, cor = corContorno) {
            const dx = Math.abs(x1 - x0), dy = Math.abs(y1 - y0);
            const sx = x0 < x1 ? 1 : -1, sy = y0 < y1 ? 1 : -1;
            let err = dx - dy;
            while (true) {
                putPixel(x0, y0, cor);
                if (x0 === x1 && y0 === y1) break;
                const e2 = 2 * err;
                if (e2 > -dy) { err -= dy; x0 += sx; }
                if (e2 < dx) { err += dx; y0 += sy; }
            }
        }

        function desenharContorno() {
            const validos = getVerticesValidos();
            if (validos.length < 3) return;
            for (let i = 0; i < validos.length; i++) {
                const j = (i + 1) % validos.length;
                bresenham(validos[i].x, validos[i].y, validos[j].x, validos[j].y, corContorno);
            }
            for (const v of validos) {
                for (let dy = -2; dy <= 2; dy++) {
                    for (let dx = -2; dx <= 2; dx++) {
                        putPixel(v.x + dx, v.y + dy, corContorno);
                    }
                }
            }
        }

        // ---- Preenchimento por Varredura ----
        function preencherVarredura() {
            const validos = getVerticesValidos();
            if (validos.length < 3) return;

            let minX = Infinity, maxX = -Infinity;
            let minY = Infinity, maxY = -Infinity;
            for (const v of validos) {
                if (v.x < minX) minX = v.x;
                if (v.x > maxX) maxX = v.x;
                if (v.y < minY) minY = v.y;
                if (v.y > maxY) maxY = v.y;
            }

            for (let y = Math.max(0, minY); y <= Math.min(399, maxY); y++) {
                const intersections = [];
                for (let i = 0; i < validos.length; i++) {
                    const j = (i + 1) % validos.length;
                    const x1 = validos[i].x, y1 = validos[i].y;
                    const x2 = validos[j].x, y2 = validos[j].y;
                    
                    if ((y1 <= y && y2 > y) || (y2 <= y && y1 > y)) {
                        const x = x1 + (y - y1) * (x2 - x1) / (y2 - y1);
                        intersections.push(Math.round(x));
                    }
                }

                intersections.sort((a, b) => a - b);
                for (let i = 0; i < intersections.length - 1; i += 2) {
                    const xStart = Math.max(0, intersections[i]);
                    const xEnd = Math.min(399, intersections[i+1]);
                    for (let x = xStart; x <= xEnd; x++) {
                        if (getPixel(x, y) !== corContorno) {
                            putPixel(x, y, corPreenchimento);
                        }
                    }
                }
            }
        }

        // ---- Preenchimento Recursivo ----
        function preencherRecursivo(sx, sy) {
            if (sx < 0 || sx >= 400 || sy < 0 || sy >= 400) return;
            if (getPixel(sx, sy) === corPreenchimento) return;
            if (getPixel(sx, sy) === corContorno) return;

            const stack = [{x: sx, y: sy}];
            const visitados = new Set();

            while (stack.length > 0) {
                const p = stack.pop();
                const key = `${p.x},${p.y}`;
                if (visitados.has(key)) continue;
                if (p.x < 0 || p.x >= 400 || p.y < 0 || p.y >= 400) continue;
                
                const corAtual = getPixel(p.x, p.y);
                if (corAtual === corPreenchimento || corAtual === corContorno) continue;
                
                putPixel(p.x, p.y, corPreenchimento);
                visitados.add(key);

                stack.push({x: p.x + 1, y: p.y});
                stack.push({x: p.x - 1, y: p.y});
                stack.push({x: p.x, y: p.y + 1});
                stack.push({x: p.x, y: p.y - 1});
            }
        }

        // ---- Canvas ----
        function limpar() {
            ctx.fillStyle = '#0f0f1f';
            ctx.fillRect(0, 0, 400, 400);
            ctx.strokeStyle = '#1a1a3a';
            ctx.lineWidth = 0.5;
            for (let i = 0; i <= 400; i += 40) {
                ctx.beginPath();
                ctx.moveTo(i, 0);
                ctx.lineTo(i, 400);
                ctx.stroke();
                ctx.beginPath();
                ctx.moveTo(0, i);
                ctx.lineTo(400, i);
                ctx.stroke();
            }
        }

        function desenhar(comPreenchimento = false) {
            limpar();
            if (comPreenchimento) {
                const metodo = getMetodo();
                if (metodo === 'scanline') {
                    preencherVarredura();
                    methodInfo.textContent = 'Varredura';
                } else {
                    preencherRecursivo(semente.x, semente.y);
                    methodInfo.textContent = 'Recursivo';
                    for (let dy = -2; dy <= 2; dy++) {
                        for (let dx = -2; dx <= 2; dx++) {
                            putPixel(semente.x + dx, semente.y + dy, corSemente);
                        }
                    }
                }
            }
            desenharContorno();
            preenchimentoAtivo = comPreenchimento;
        }

        // ---- Gerenciamento de vértices ----
        function adicionarVertice(x, y) {
            if (x === undefined || y === undefined) {
                x = Math.floor(Math.random() * 380) + 10;
                y = Math.floor(Math.random() * 380) + 10;
            }
            vertices.push({ x, y });
            renderizarLista();
            desenhar(preenchimentoAtivo);
        }

        function removerUltimo() {
            if (vertices.length > 3) {
                vertices.pop();
                renderizarLista();
                desenhar(preenchimentoAtivo);
            } else {
                alert('Mínimo de 3 vértices!');
            }
        }

        function limparVertices() {
            if (vertices.length > 3) {
                if (confirm('Remover todos os vértices? (mínimo 3)')) {
                    const primeiros = vertices.slice(0, 3);
                    vertices = primeiros;
                    renderizarLista();
                    desenhar(false);
                    preenchimentoAtivo = false;
                }
            } else {
                alert('Já está no mínimo de 3 vértices!');
            }
        }

        function gerarAleatorio() {
            const numVerts = Math.floor(Math.random() * 5) + 5;
            const novos = [];
            const cx = 200, cy = 200;
            const raio = Math.random() * 120 + 60;
            for (let i = 0; i < numVerts; i++) {
                const ang = (i / numVerts) * 2 * Math.PI + Math.random() * 0.4;
                const r = raio * (0.6 + Math.random() * 0.5);
                novos.push({
                    x: Math.min(Math.max(cx + r * Math.cos(ang), 10), 390),
                    y: Math.min(Math.max(cy + r * Math.sin(ang), 10), 390)
                });
            }
            vertices = novos;
            renderizarLista();
            desenhar(preenchimentoAtivo);
        }

        // ---- Eventos ----
        addPointBtn.addEventListener('click', () => adicionarVertice());
        removeLastBtn.addEventListener('click', removerUltimo);
        clearPointsBtn.addEventListener('click', limparVertices);
        drawOnlyBtn.addEventListener('click', () => { desenhar(false); preenchimentoAtivo = false; });
        fillBtn.addEventListener('click', () => { desenhar(true); preenchimentoAtivo = true; });
        randomBtn.addEventListener('click', gerarAleatorio);

        pickSeedBtn.addEventListener('click', () => {
            const x = parseInt(seedX.value, 10);
            const y = parseInt(seedY.value, 10);
            if (!isNaN(x) && !isNaN(y) && x >= 0 && x < 400 && y >= 0 && y < 400) {
                semente = { x, y };
                seedStatus.textContent = `🌱 Semente em (${x}, ${y})`;
                seedStatus.style.color = '#2ecc71';
                if (getMetodo() === 'recursive') {
                    desenhar(preenchimentoAtivo);
                }
            }
        });

        // Clique no canvas
        canvas.addEventListener('click', (e) => {
            const rect = canvas.getBoundingClientRect();
            const scaleX = canvas.width / rect.width;
            const scaleY = canvas.height / rect.height;
            const mx = Math.round((e.clientX - rect.left) * scaleX);
            const my = Math.round((e.clientY - rect.top) * scaleY);
            if (mx < 0 || mx >= 400 || my < 0 || my >= 400) return;

            if (getMetodo() === 'recursive') {
                semente = { x: mx, y: my };
                seedX.value = mx;
                seedY.value = my;
                seedStatus.textContent = `🌱 Semente em (${mx}, ${my})`;
                seedStatus.style.color = '#2ecc71';
                desenhar(preenchimentoAtivo);
                return;
            }

            const validos = getVerticesValidos();
            let encontrado = false;
            for (let i = 0; i < validos.length; i++) {
                const d = (mx - validos[i].x) ** 2 + (my - validos[i].y) ** 2;
                if (d < 400) {
                    vertices[i].x = mx;
                    vertices[i].y = my;
                    renderizarLista();
                    desenhar(preenchimentoAtivo);
                    encontrado = true;
                    break;
                }
            }
            if (!encontrado) {
                adicionarVertice(mx, my);
            }
        });

        // Mudança de método
        document.querySelectorAll('input[name="method"]').forEach(radio => {
            radio.addEventListener('change', () => {
                const metodo = getMetodo();
                if (metodo === 'recursive') {
                    seedStatus.textContent = `🌱 Semente em (${semente.x}, ${semente.y})`;
                    seedStatus.style.color = '#2ecc71';
                } else {
                    seedStatus.textContent = 'Clique no canvas para definir';
                    seedStatus.style.color = '#888';
                }
                if (preenchimentoAtivo) desenhar(true);
            });
        });

        // Inicialização
        renderizarLista();
        desenhar(false);
        seedStatus.textContent = `🌱 Semente em (${semente.x}, ${semente.y})`;
        seedStatus.style.color = '#2ecc71';

        window.__state = { vertices, semente };
    })();
</script>

</body>
</html>
