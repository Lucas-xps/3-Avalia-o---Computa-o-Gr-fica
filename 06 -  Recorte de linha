<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recorte de Linha - Cohen-Sutherland</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #1a1a2e;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #eee;
        }
        .container {
            background: #16213e;
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            text-align: center;
            max-width: 950px;
        }
        h1 {
            font-size: 1.5rem;
            font-weight: 400;
            letter-spacing: 1px;
            margin-bottom: 8px;
            color: #e0e0e0;
        }
        h1 span {
            color: #f39c12;
            font-weight: 600;
        }
        .subtitle {
            font-size: 0.85rem;
            color: #888;
            margin-bottom: 15px;
        }

        /* Layout principal: Imagens | Parâmetros */
        .main-layout {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
        }

        /* Área de Imagens (canvas) */
        .canvas-wrapper {
            flex: 1;
            min-width: 500px;
            background: #0f0f1f;
            border: 2px solid #2c3e6b;
            border-radius: 10px;
            padding: 5px;
            box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.7);
        }
        .canvas-wrapper .canvas-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 4px 10px;
            background: #1a1a3a;
            border-radius: 6px 6px 0 0;
            border-bottom: 1px solid #2c3e6b;
        }
        .canvas-wrapper .canvas-header span {
            font-size: 0.7rem;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .canvas-wrapper .canvas-header .badge {
            background: #2c3e6b;
            padding: 2px 10px;
            border-radius: 10px;
            font-size: 0.6rem;
            color: #aaa;
        }
        .canvas-wrapper .canvas-header .badge .status-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            margin-right: 4px;
        }
        .canvas-wrapper .canvas-header .badge .status-dot.inside { background: #2ecc71; }
        .canvas-wrapper .canvas-header .badge .status-dot.outside { background: #e74c3c; }
        .canvas-wrapper .canvas-header .badge .status-dot.partial { background: #f39c12; }
        .canvas-wrapper .canvas-header .badge .status-dot.none { background: #555; }
        canvas {
            display: block;
            width: 100%;
            height: auto;
            aspect-ratio: 700/500;
            background: #0f0f1f;
            cursor: crosshair;
            border-radius: 0 0 8px 8px;
        }

        /* Área de Parâmetros (sidebar) */
        .sidebar {
            background: #1a1a3a;
            padding: 16px 18px;
            border-radius: 10px;
            border: 1px solid #2a2a5a;
            min-width: 200px;
            flex: 0 0 230px;
            text-align: left;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .sidebar .section-title {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #666;
            border-bottom: 1px solid #2a2a5a;
            padding-bottom: 4px;
            text-align: center;
            margin-bottom: 4px;
        }
        .sidebar .param-group {
            display: flex;
            flex-direction: column;
            gap: 2px;
        }
        .sidebar .param-group label {
            font-size: 0.72rem;
            color: #aaa;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .sidebar .param-group label .label-text {
            color: #888;
        }
        .sidebar .param-group label .value-display {
            color: #f39c12;
            font-weight: 600;
            font-size: 0.75rem;
            min-width: 35px;
            text-align: right;
        }
        .sidebar .param-group input[type="number"] {
            width: 100%;
            padding: 4px 8px;
            border-radius: 4px;
            border: none;
            background: #2a2a4a;
            color: #fff;
            font-weight: 600;
            text-align: center;
            font-size: 0.8rem;
        }
        .sidebar .param-group input[type="range"] {
            width: 100%;
            accent-color: #f39c12;
            height: 4px;
            background: #2a2a4a;
            border-radius: 2px;
            outline: none;
        }
        .sidebar .param-group input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 14px;
            height: 14px;
            border-radius: 50%;
            background: #f39c12;
            cursor: pointer;
        }
        .sidebar .param-group select {
            width: 100%;
            padding: 4px 8px;
            border-radius: 4px;
            border: none;
            background: #2a2a4a;
            color: #fff;
            font-size: 0.78rem;
            cursor: pointer;
        }
        .sidebar .param-group select:focus {
            outline: 2px solid #f39c12;
        }
        .sidebar .param-group .hint {
            font-size: 0.6rem;
            color: #555;
            text-align: right;
            margin-top: -2px;
        }

        .sidebar .btn-group {
            display: flex;
            gap: 5px;
            flex-wrap: wrap;
            margin-top: 4px;
        }
        .sidebar .btn-group .btn {
            flex: 1;
            min-width: 55px;
            padding: 5px 10px;
            border: none;
            border-radius: 14px;
            font-weight: 600;
            font-size: 0.65rem;
            cursor: pointer;
            transition: all 0.2s;
            letter-spacing: 0.3px;
            box-shadow: 0 2px 0 #0a0a1a;
            color: #fff;
            text-align: center;
        }
        .sidebar .btn-group .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 0 #0a0a1a;
        }
        .sidebar .btn-group .btn:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 #0a0a1a;
        }
        .btn-warning { background: #d35400; }
        .btn-warning:hover { background: #e67e22; }
        .btn-success { background: #27ae60; }
        .btn-success:hover { background: #2ecc71; }
        .btn-danger { background: #c0392b; }
        .btn-danger:hover { background: #e74c3c; }
        .btn-primary { background: #2980b9; }
        .btn-primary:hover { background: #3498db; }

        /* Legendas */
        .legend {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 6px;
            font-size: 0.65rem;
            flex-wrap: wrap;
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .legend-color {
            width: 18px;
            height: 2px;
            border-radius: 2px;
        }
        .legend-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
        }

        /* Status e Info */
        .status {
            margin-top: 8px;
            font-size: 0.78rem;
            color: #7f8c8d;
        }
        .status span {
            color: #2ecc71;
            font-weight: 600;
        }
        .status .error {
            color: #e74c3c;
        }
        .status .partial {
            color: #f39c12;
        }
        .info {
            margin-top: 6px;
            font-size: 0.72rem;
            color: #aaa;
            background: #0d0d1f;
            padding: 4px 14px;
            border-radius: 16px;
            display: inline-block;
            border: 1px solid #2a2a4a;
        }
        .info strong {
            color: #f39c12;
        }

        .line-coords {
            font-size: 0.7rem;
            color: #888;
            margin-top: 4px;
            text-align: center;
        }
        .line-coords strong {
            color: #f39c12;
        }

        @media (max-width: 780px) {
            .main-layout {
                flex-direction: column;
            }
            .canvas-wrapper {
                min-width: unset;
            }
            .sidebar {
                flex: 1;
                min-width: unset;
            }
        }
    </style>
</head>
<body>

<div class="container">
    <h1>✂️ Recorte de Linha — <span>Cohen-Sutherland</span></h1>
    <div class="subtitle">Síntese e Processamento de Imagem</div>

    <!-- Layout: Imagens | Parâmetros -->
    <div class="main-layout">
        <!-- Área de Imagens -->
        <div class="canvas-wrapper">
            <div class="canvas-header">
                <span>📐 Recorte de Linha</span>
                <span class="badge">
                    <span class="status-dot none" id="statusDot"></span>
                    <span id="badgeStatus">Aguardando</span>
                </span>
            </div>
            <canvas id="canvas" width="700" height="500"></canvas>

            <div class="legend">
                <div class="legend-item"><span class="legend-color" style="background: #e74c3c;"></span> Original</div>
                <div class="legend-item"><span class="legend-color" style="background: #2ecc71;"></span> Recortada</div>
                <div class="legend-item"><span class="legend-dot" style="background: #f1c40f;"></span> Janela</div>
                <div class="legend-item"><span class="legend-dot" style="background: #e74c3c; width: 5px; height: 5px;"></span> Pontos</div>
            </div>
        </div>

        <!-- Área de Parâmetros -->
        <div class="sidebar">
            <div class="section-title">⚙️ Parâmetros</div>

            <div class="param-group">
                <label>
                    <span class="label-text">📐 Janela X</span>
                </label>
                <input type="number" id="winX" value="200" min="10" max="680">
            </div>

            <div class="param-group">
                <label>
                    <span class="label-text">📐 Janela Y</span>
                </label>
                <input type="number" id="winY" value="150" min="10" max="480">
            </div>

            <div class="param-group">
                <label>
                    <span class="label-text">📏 Largura</span>
                </label>
                <input type="number" id="winW" value="300" min="20" max="680">
            </div>

            <div class="param-group">
                <label>
                    <span class="label-text">📏 Altura</span>
                </label>
                <input type="number" id="winH" value="200" min="20" max="480">
            </div>

            <div class="param-group" style="margin-top:4px;">
                <label>
                    <span class="label-text">🎨 Cor do Recorte</span>
                </label>
                <input type="color" id="clipColor" value="#2ecc71" style="width:100%;padding:2px;background:#2a2a4a;border:none;border-radius:4px;cursor:pointer;">
            </div>

            <div class="btn-group">
                <button class="btn btn-warning" id="btnRandom">🎲 Aleatório</button>
                <button class="btn btn-primary" id="btnExample">📋 Exemplo</button>
                <button class="btn btn-success" id="btnClip">✂️ Recortar</button>
                <button class="btn btn-danger" id="btnClear">🗑️ Limpar</button>
            </div>

            <div class="line-coords" id="coordDisplay">
                P1: <strong>(0,0)</strong> → P2: <strong>(0,0)</strong>
            </div>
        </div>
    </div>

    <div class="status" id="statusMsg">🖱️ Clique no canvas para definir o <span>início</span> da linha</div>
    <div class="info">
        🖱️ Clique para definir pontos | <strong>Enter</strong> para recortar | <strong>Esc</strong> para limpar
    </div>
</div>

<script>
    (function() {
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');

        // --- estado ---
        let points = [];
        let clipWindow = { x: 200, y: 150, w: 300, h: 200 };
        let clippedLine = null;
        let clipColor = '#2ecc71';

        // referências DOM
        const winX = document.getElementById('winX');
        const winY = document.getElementById('winY');
        const winW = document.getElementById('winW');
        const winH = document.getElementById('winH');
        const clipColorInput = document.getElementById('clipColor');
        const coordDisplay = document.getElementById('coordDisplay');
        const statusMsg = document.getElementById('statusMsg');
        const statusDot = document.getElementById('statusDot');
        const badgeStatus = document.getElementById('badgeStatus');

        // --- constantes de codificação (Cohen-Sutherland) ---
        const INSIDE = 0;
        const LEFT   = 1;
        const RIGHT  = 2;
        const BOTTOM = 4;
        const TOP    = 8;

        function computeCode(x, y, win) {
            let code = INSIDE;
            if (x < win.x) code |= LEFT;
            else if (x > win.x + win.w) code |= RIGHT;
            if (y < win.y) code |= BOTTOM;
            else if (y > win.y + win.h) code |= TOP;
            return code;
        }

        // --- algoritmo de Cohen-Sutherland ---
        function cohenSutherland(x1, y1, x2, y2, win) {
            let code1 = computeCode(x1, y1, win);
            let code2 = computeCode(x2, y2, win);
            let accept = false;

            while (true) {
                if ((code1 === 0) && (code2 === 0)) {
                    accept = true;
                    break;
                } else if (code1 & code2) {
                    break;
                } else {
                    let codeOut = (code1 !== 0) ? code1 : code2;
                    let x, y;

                    const xMin = win.x, xMax = win.x + win.w;
                    const yMin = win.y, yMax = win.y + win.h;

                    if (codeOut & TOP) {
                        x = x1 + (x2 - x1) * (yMax - y1) / (y2 - y1);
                        y = yMax;
                    } else if (codeOut & BOTTOM) {
                        x = x1 + (x2 - x1) * (yMin - y1) / (y2 - y1);
                        y = yMin;
                    } else if (codeOut & RIGHT) {
                        y = y1 + (y2 - y1) * (xMax - x1) / (x2 - x1);
                        x = xMax;
                    } else if (codeOut & LEFT) {
                        y = y1 + (y2 - y1) * (xMin - x1) / (x2 - x1);
                        x = xMin;
                    }

                    if (codeOut === code1) {
                        x1 = x;
                        y1 = y;
                        code1 = computeCode(x1, y1, win);
                    } else {
                        x2 = x;
                        y2 = y;
                        code2 = computeCode(x2, y2, win);
                    }
                }
            }

            if (accept) {
                return { x1, y1, x2, y2 };
            } else {
                return null;
            }
        }

        // --- desenho ---
        function draw() {
            ctx.clearRect(0, 0, 700, 500);

            // Grade
            ctx.strokeStyle = '#1e1e3a';
            ctx.lineWidth = 0.5;
            for (let x = 0; x <= 700; x += 40) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, 500);
                ctx.stroke();
            }
            for (let y = 0; y <= 500; y += 40) {
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(700, y);
                ctx.stroke();
            }

            const win = clipWindow;

            // --- janela de recorte ---
            ctx.strokeStyle = '#f1c40f';
            ctx.lineWidth = 3;
            ctx.setLineDash([6, 6]);
            ctx.strokeRect(win.x, win.y, win.w, win.h);
            ctx.setLineDash([]);

            ctx.fillStyle = '#f1c40f';
            ctx.font = '11px monospace';
            ctx.textAlign = 'left';
            ctx.fillText('Janela de recorte', win.x + 6, win.y - 8);

            ctx.fillStyle = 'rgba(241, 196, 15, 0.05)';
            ctx.fillRect(win.x, win.y, win.w, win.h);

            // --- linha original ---
            if (points.length === 2) {
                const [p1, p2] = points;
                ctx.strokeStyle = '#e74c3c';
                ctx.lineWidth = 2;
                ctx.setLineDash([4, 6]);
                ctx.beginPath();
                ctx.moveTo(p1.x, p1.y);
                ctx.lineTo(p2.x, p2.y);
                ctx.stroke();
                ctx.setLineDash([]);

                ctx.fillStyle = '#e74c3c';
                [p1, p2].forEach(p => {
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, 4, 0, 2 * Math.PI);
                    ctx.fill();
                });

                ctx.fillStyle = '#e74c3c';
                ctx.font = '10px monospace';
                ctx.fillText('Original', p1.x + 8, p1.y - 6);
            }

            // --- linha recortada ---
            if (clippedLine) {
                const { x1, y1, x2, y2 } = clippedLine;
                const color = clipColor;
                
                ctx.shadowColor = color;
                ctx.shadowBlur = 12;
                ctx.strokeStyle = color;
                ctx.lineWidth = 4;
                ctx.beginPath();
                ctx.moveTo(x1, y1);
                ctx.lineTo(x2, y2);
                ctx.stroke();
                ctx.shadowBlur = 0;

                ctx.fillStyle = color;
                [{x: x1, y: y1}, {x: x2, y: y2}].forEach(p => {
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, 5, 0, 2 * Math.PI);
                    ctx.fill();
                });

                ctx.fillStyle = color;
                ctx.font = '10px monospace';
                ctx.fillText('Recortada', x1 + 10, y1 - 8);
            }

            // --- ponto único ---
            if (points.length === 1) {
                ctx.fillStyle = '#f39c12';
                ctx.beginPath();
                ctx.arc(points[0].x, points[0].y, 5, 0, 2 * Math.PI);
                ctx.fill();
                ctx.fillStyle = '#f39c12';
                ctx.font = '10px monospace';
                ctx.fillText('Início', points[0].x + 10, points[0].y - 6);
            }

            // --- atualizar status ---
            updateStatus();
        }

        function updateStatus() {
            const win = clipWindow;
            
            if (points.length === 0) {
                statusMsg.innerHTML = '🖱️ Clique no canvas para definir o <span>início</span> da linha';
                coordDisplay.innerHTML = 'P1: <strong>(0,0)</strong> → P2: <strong>(0,0)</strong>';
                statusDot.className = 'status-dot none';
                badgeStatus.textContent = 'Aguardando';
                return;
            }

            if (points.length === 1) {
                statusMsg.innerHTML = '🖱️ Clique novamente para definir o <span>fim</span> da linha';
                coordDisplay.innerHTML = `P1: <strong>(${Math.round(points[0].x)},${Math.round(points[0].y)})</strong> → P2: <strong>?</strong>`;
                statusDot.className = 'status-dot none';
                badgeStatus.textContent = '1 ponto';
                return;
            }

            // 2 pontos
            const [p1, p2] = points;
            const code1 = computeCode(p1.x, p1.y, win);
            const code2 = computeCode(p2.x, p2.y, win);
            
            coordDisplay.innerHTML = `P1: <strong>(${Math.round(p1.x)},${Math.round(p1.y)})</strong> → P2: <strong>(${Math.round(p2.x)},${Math.round(p2.y)})</strong>`;

            if (code1 === 0 && code2 === 0) {
                statusMsg.innerHTML = '✅ Linha totalmente <span>dentro</span> da janela';
                statusDot.className = 'status-dot inside';
                badgeStatus.textContent = 'Dentro';
            } else if (code1 & code2) {
                statusMsg.innerHTML = '❌ Linha totalmente <span class="error">fora</span> da janela';
                statusDot.className = 'status-dot outside';
                badgeStatus.textContent = 'Fora';
            } else {
                statusMsg.innerHTML = '✂️ Linha <span class="partial">parcialmente</span> dentro — clique em "Recortar"';
                statusDot.className = 'status-dot partial';
                badgeStatus.textContent = 'Parcial';
            }
        }

        // --- atualizar janela ---
        function updateWindowFromInputs() {
            const x = parseInt(winX.value, 10) || 0;
            const y = parseInt(winY.value, 10) || 0;
            const w = parseInt(winW.value, 10) || 20;
            const h = parseInt(winH.value, 10) || 20;
            clipWindow.x = Math.min(Math.max(x, 0), 680);
            clipWindow.y = Math.min(Math.max(y, 0), 480);
            clipWindow.w = Math.min(Math.max(w, 10), 700 - clipWindow.x);
            clipWindow.h = Math.min(Math.max(h, 10), 500 - clipWindow.y);
            winX.value = clipWindow.x;
            winY.value = clipWindow.y;
            winW.value = clipWindow.w;
            winH.value = clipWindow.h;
            if (points.length === 2) performClip();
            draw();
        }

        // --- executar recorte ---
        function performClip() {
            if (points.length !== 2) {
                clippedLine = null;
                draw();
                return;
            }
            const [p1, p2] = points;
            const result = cohenSutherland(p1.x, p1.y, p2.x, p2.y, clipWindow);
            clippedLine = result;
            draw();
        }

        // --- gerar linha aleatória ---
        function randomLine() {
            const margin = 20;
            const x1 = Math.random() * 700;
            const y1 = Math.random() * 500;
            const x2 = Math.random() * 700;
            const y2 = Math.random() * 500;
            points = [
                { x: Math.min(Math.max(x1, margin), 700 - margin), y: Math.min(Math.max(y1, margin), 500 - margin) },
                { x: Math.min(Math.max(x2, margin), 700 - margin), y: Math.min(Math.max(y2, margin), 500 - margin) }
            ];
            performClip();
            statusMsg.innerHTML = '🎲 Linha aleatória <span>gerada</span>!';
        }

        // --- carregar exemplo ---
        function loadExample() {
            points = [
                { x: 50, y: 50 },
                { x: 650, y: 450 }
            ];
            performClip();
            statusMsg.innerHTML = '📋 Exemplo <span>carregado</span>!';
        }

        // --- eventos do canvas ---
        canvas.addEventListener('click', (e) => {
            const rect = canvas.getBoundingClientRect();
            const scaleX = canvas.width / rect.width;
            const scaleY = canvas.height / rect.height;
            const x = (e.clientX - rect.left) * scaleX;
            const y = (e.clientY - rect.top) * scaleY;
            const clampedX = Math.min(Math.max(x, 0), 700);
            const clampedY = Math.min(Math.max(y, 0), 500);

            if (points.length === 0) {
                points = [{ x: clampedX, y: clampedY }];
                clippedLine = null;
                draw();
            } else if (points.length === 1) {
                points.push({ x: clampedX, y: clampedY });
                performClip();
            } else {
                points = [{ x: clampedX, y: clampedY }];
                clippedLine = null;
                draw();
            }
        });

        // Teclas
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                performClip();
            }
            if (e.key === 'Escape') {
                points = [];
                clippedLine = null;
                draw();
                statusMsg.innerHTML = '🗑️ Linha <span>limpa</span>. Clique para adicionar pontos';
            }
        });

        // --- eventos dos botões ---
        document.getElementById('btnRandom').addEventListener('click', randomLine);
        document.getElementById('btnExample').addEventListener('click', loadExample);
        document.getElementById('btnClip').addEventListener('click', performClip);
        document.getElementById('btnClear').addEventListener('click', () => {
            points = [];
            clippedLine = null;
            draw();
            statusMsg.innerHTML = '🗑️ Linha <span>limpa</span>. Clique para adicionar pontos';
        });

        // --- eventos dos inputs ---
        [winX, winY, winW, winH].forEach(input => {
            input.addEventListener('input', updateWindowFromInputs);
        });

        clipColorInput.addEventListener('input', () => {
            clipColor = clipColorInput.value;
            draw();
        });

        // --- inicializar ---
        loadExample();

        window.__state = { points, clipWindow, clippedLine };
    })();
</script>

