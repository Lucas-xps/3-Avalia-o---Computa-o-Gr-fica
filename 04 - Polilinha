<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Polilinha · Rasterização</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #1a1a2e;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #eee;
        }
        .container {
            background: #16213e;
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            text-align: center;
            max-width: 950px;
        }
        h1 {
            font-size: 1.5rem;
            font-weight: 400;
            letter-spacing: 1px;
            margin-bottom: 8px;
            color: #e0e0e0;
        }
        h1 span {
            color: #e67e22;
            font-weight: 600;
        }
        .subtitle {
            font-size: 0.85rem;
            color: #888;
            margin-bottom: 15px;
        }

        /* Layout principal: Imagens | Parâmetros */
        .main-layout {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            justify-content: center;
        }

        /* Área de Imagens (canvas) */
        .canvas-wrapper {
            flex: 1;
            min-width: 400px;
            background: #0f0f1f;
            border: 2px solid #2c3e6b;
            border-radius: 10px;
            padding: 5px;
            box-shadow: inset 0 0 30px rgba(0, 0, 0, 0.7);
        }
        .canvas-wrapper .canvas-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 4px 10px;
            background: #1a1a3a;
            border-radius: 6px 6px 0 0;
            border-bottom: 1px solid #2c3e6b;
        }
        .canvas-wrapper .canvas-header span {
            font-size: 0.7rem;
            color: #888;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .canvas-wrapper .canvas-header .badge {
            background: #2c3e6b;
            padding: 2px 10px;
            border-radius: 10px;
            font-size: 0.6rem;
            color: #aaa;
        }
        .canvas-wrapper .canvas-header .badge .count {
            color: #e67e22;
            font-weight: 600;
        }
        canvas {
            display: block;
            width: 100%;
            height: auto;
            aspect-ratio: 400/400;
            background: #0f0f1f;
            cursor: crosshair;
            border-radius: 0 0 8px 8px;
            image-rendering: crisp-edges;
            image-rendering: pixelated;
        }

        /* Área de Parâmetros (sidebar) */
        .sidebar {
            background: #1a1a3a;
            padding: 16px 18px;
            border-radius: 10px;
            border: 1px solid #2a2a5a;
            min-width: 200px;
            flex: 0 0 250px;
            text-align: left;
            display: flex;
            flex-direction: column;
            gap: 8px;
            max-height: 520px;
        }
        .sidebar .section-title {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: #666;
            border-bottom: 1px solid #2a2a5a;
            padding-bottom: 4px;
            text-align: center;
            margin-bottom: 4px;
            flex-shrink: 0;
        }
        .sidebar .param-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
            flex-shrink: 0;
        }
        .sidebar .param-group label {
            font-size: 0.72rem;
            color: #aaa;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .sidebar .param-group label .label-text {
            color: #888;
        }
        .sidebar .param-group label .value-display {
            color: #e67e22;
            font-weight: 600;
            font-size: 0.75rem;
            min-width: 35px;
            text-align: right;
        }

        .sidebar .btn-group {
            display: flex;
            gap: 4px;
            flex-wrap: wrap;
            flex-shrink: 0;
        }
        .sidebar .btn-group .btn {
            flex: 1;
            min-width: 45px;
            padding: 5px 8px;
            border: none;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.62rem;
            cursor: pointer;
            transition: all 0.2s;
            letter-spacing: 0.3px;
            box-shadow: 0 2px 0 #0a0a1a;
            color: #fff;
            text-align: center;
        }
        .sidebar .btn-group .btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 0 #0a0a1a;
        }
        .sidebar .btn-group .btn:active {
            transform: translateY(3px);
            box-shadow: 0 1px 0 #0a0a1a;
        }
        .btn-warning { background: #d35400; }
        .btn-warning:hover { background: #e67e22; }
        .btn-success { background: #27ae60; }
        .btn-success:hover { background: #2ecc71; }
        .btn-danger { background: #c0392b; }
        .btn-danger:hover { background: #e74c3c; }
        .btn-primary { background: #2980b9; }
        .btn-primary:hover { background: #3498db; }
        .btn-secondary { background: #2a2a5a; }
        .btn-secondary:hover { background: #3d3d7a; }
        .btn-small { font-size: 0.58rem; padding: 3px 8px; }

        /* Lista de pontos */
        .points-scroll {
            flex: 1;
            overflow-y: auto;
            padding-right: 4px;
            margin: 4px 0;
            min-height: 60px;
            max-height: 140px;
        }
        .points-scroll::-webkit-scrollbar { width: 4px; }
        .points-scroll::-webkit-scrollbar-thumb { background: #2a2a4a; border-radius: 10px; }
        .point-item {
            display: flex;
            align-items: center;
            gap: 4px;
            padding: 2px 6px;
            border-radius: 4px;
            background: #12122a;
            margin-bottom: 2px;
            font-size: 0.65rem;
        }
        .point-item .idx {
            font-weight: 600;
            color: #e67e22;
            min-width: 20px;
            font-size: 0.6rem;
        }
        .point-item input[type="number"] {
            width: 35px;
            padding: 1px 3px;
            border: 1px solid #2a2a4a;
            border-radius: 3px;
            background: #1a1a3a;
            color: #fff;
            font-size: 0.6rem;
            text-align: center;
        }
        .point-item .btn-remove {
            background: none;
            border: none;
            color: #e74c3c;
            cursor: pointer;
            font-weight: bold;
            font-size: 0.7rem;
            padding: 0 2px;
        }
        .point-item .btn-remove:hover { color: #ff6b6b; }

        /* Legendas */
        .legend {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 4px;
            font-size: 0.6rem;
            flex-wrap: wrap;
        }
        .legend-item {
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
        }
        .legend-color {
            width: 16px;
            height: 2px;
            border-radius: 2px;
        }

        /* Info line */
        .info-line {
            display: flex;
            justify-content: space-between;
            font-size: 0.65rem;
            color: #888;
            background: #0d0d1f;
            padding: 4px 12px;
            border-radius: 12px;
            border: 1px solid #2a2a4a;
            flex-shrink: 0;
        }
        .info-line span { color: #aaa; }
        .info-line .val { color: #e67e22; font-weight: 600; }

        .status-msg {
            font-size: 0.65rem;
            color: #888;
            background: #0d0d1f;
            padding: 3px 10px;
            border-radius: 12px;
            text-align: center;
            border: 1px solid #2a2a4a;
            flex-shrink: 0;
        }

        @media (max-width: 780px) {
            .main-layout { flex-direction: column; }
            .canvas-wrapper { min-width: unset; }
            .sidebar { flex: 1; min-width: unset; max-height: none; }
            .points-scroll { max-height: 100px; }
        }
    </style>
</head>
<body>

<div class="container">
    <h1>📐 Polilinha — <span>Rasterização · Bresenham</span></h1>
    <div class="subtitle">Síntese e Processamento de Imagem</div>

    <!-- Layout: Imagens | Parâmetros -->
    <div class="main-layout">
        <!-- Área de Imagens -->
        <div class="canvas-wrapper">
            <div class="canvas-header">
                <span>📐 Polilinha</span>
                <span class="badge">Pontos: <span class="count" id="badgeCount">0</span></span>
            </div>
            <canvas id="canvas" width="400" height="400"></canvas>

            <div class="legend">
                <div class="legend-item"><span class="legend-color" style="background: #1a2633;"></span> Segmentos</div>
                <div class="legend-item"><span class="legend-dot" style="background: #c0392b;"></span> Vértices</div>
                <div class="legend-item"><span class="legend-dot" style="background: #e67e22; width: 5px; height: 5px;"></span> Pontos</div>
            </div>
        </div>

        <!-- Área de Parâmetros -->
        <div class="sidebar">
            <div class="section-title">⚙️ Parâmetros</div>

            <div class="param-group" style="flex-shrink:0;">
                <label><span class="label-text">➕ Gerenciar pontos</span></label>
                <div class="btn-group">
                    <button class="btn btn-success btn-small" id="addPointBtn">+ Adicionar</button>
                    <button class="btn btn-danger btn-small" id="removeLastBtn">- Último</button>
                    <button class="btn btn-secondary btn-small" id="clearPointsBtn">Limpar</button>
                </div>
            </div>

            <div class="param-group" style="flex:1; min-height:0;">
                <label>📌 Pontos (N = <span id="pointCount">0</span>)</label>
                <div class="points-scroll" id="pointsList"></div>
            </div>

            <div class="param-group">
                <label>
                    <span class="label-text">🎨 Cor dos Segmentos</span>
                </label>
                <input type="color" id="lineColor" value="#1a2633" style="width:100%;padding:2px;background:#2a2a4a;border:none;border-radius:4px;cursor:pointer;">
            </div>

            <div class="param-group">
                <label>
                    <span class="label-text">🎨 Cor dos Vértices</span>
                </label>
                <input type="color" id="vertexColor" value="#c0392b" style="width:100%;padding:2px;background:#2a2a4a;border:none;border-radius:4px;cursor:pointer;">
            </div>

            <div class="btn-group" style="flex-shrink:0;">
                <button class="btn btn-primary" id="drawBtn">🔄 Redesenhar</button>
                <button class="btn btn-warning" id="randomBtn">🎲 Aleatório</button>
            </div>

            <div class="info-line">
                <span>🔹 Vértices: <span class="val" id="vertexInfo">0</span></span>
                <span>🔸 Segmentos: <span class="val" id="segmentsInfo">0</span></span>
            </div>

            <div class="status-msg" id="statusMsg">Clique no canvas para adicionar/mover pontos</div>
        </div>
    </div>
</div>

<script>
    (function() {
        const canvas = document.getElementById('canvas');
        const ctx = canvas.getContext('2d');
        const pointsList = document.getElementById('pointsList');
        const pointCount = document.getElementById('pointCount');
        const badgeCount = document.getElementById('badgeCount');
        const vertexInfo = document.getElementById('vertexInfo');
        const segmentsInfo = document.getElementById('segmentsInfo');
        const statusMsg = document.getElementById('statusMsg');

        const addPointBtn = document.getElementById('addPointBtn');
        const removeLastBtn = document.getElementById('removeLastBtn');
        const clearPointsBtn = document.getElementById('clearPointsBtn');
        const drawBtn = document.getElementById('drawBtn');
        const randomBtn = document.getElementById('randomBtn');
        const lineColorInput = document.getElementById('lineColor');
        const vertexColorInput = document.getElementById('vertexColor');

        // Lista de pontos da polilinha
        let pontos = [
            { x: 50, y: 350 },
            { x: 120, y: 80 },
            { x: 200, y: 150 },
            { x: 300, y: 60 },
            { x: 350, y: 320 }
        ];

        let corVertice = '#c0392b';
        let corLinha = '#1a2633';

        // ---- Funções auxiliares ----
        function getPontosValidos() {
            return pontos.filter(p => p.x >= 0 && p.x < 400 && p.y >= 0 && p.y < 400);
        }

        // ---- Interface ----
        function renderizarLista() {
            const validos = getPontosValidos();
            let html = '';
            validos.forEach((p, i) => {
                html += `
                    <div class="point-item" data-idx="${i}">
                        <span class="idx">#${i+1}</span>
                        <input type="number" class="pt-x" value="${p.x}" min="0" max="399" step="1">
                        <input type="number" class="pt-y" value="${p.y}" min="0" max="399" step="1">
                        <button class="btn-remove" data-idx="${i}">✕</button>
                    </div>
                `;
            });
            pointsList.innerHTML = html;
            pointCount.textContent = validos.length;
            badgeCount.textContent = validos.length;

            document.querySelectorAll('.pt-x').forEach((inp, i) => {
                inp.addEventListener('input', () => {
                    const val = parseInt(inp.value, 10);
                    if (!isNaN(val) && val >= 0 && val < 400 && i < pontos.length) {
                        pontos[i].x = val;
                        desenhar();
                    }
                });
            });
            document.querySelectorAll('.pt-y').forEach((inp, i) => {
                inp.addEventListener('input', () => {
                    const val = parseInt(inp.value, 10);
                    if (!isNaN(val) && val >= 0 && val < 400 && i < pontos.length) {
                        pontos[i].y = val;
                        desenhar();
                    }
                });
            });

            document.querySelectorAll('.btn-remove').forEach(btn => {
                btn.addEventListener('click', () => {
                    const idx = parseInt(btn.dataset.idx, 10);
                    if (pontos.length > 4) {
                        pontos.splice(idx, 1);
                        renderizarLista();
                        desenhar();
                    } else {
                        alert('Mínimo de 4 pontos!');
                    }
                });
            });

            atualizarInfo();
        }

        function atualizarInfo() {
            const validos = getPontosValidos();
            vertexInfo.textContent = validos.length;
            segmentsInfo.textContent = Math.max(0, validos.length - 1);
        }

        // ---- Rasterização ----
        function putPixel(x, y, cor = corLinha) {
            if (x < 0 || x >= 400 || y < 0 || y >= 400) return;
            const img = ctx.getImageData(0, 0, 400, 400);
            const d = img.data;
            const idx = (y * 400 + x) * 4;
            const r = parseInt(cor.slice(1,3), 16);
            const g = parseInt(cor.slice(3,5), 16);
            const b = parseInt(cor.slice(5,7), 16);
            d[idx] = r; d[idx+1] = g; d[idx+2] = b; d[idx+3] = 255;
            ctx.putImageData(img, 0, 0);
        }

        function bresenham(x0, y0, x1, y1) {
            const dx = Math.abs(x1 - x0), dy = Math.abs(y1 - y0);
            const sx = x0 < x1 ? 1 : -1, sy = y0 < y1 ? 1 : -1;
            let err = dx - dy;
            while (true) {
                putPixel(x0, y0);
                if (x0 === x1 && y0 === y1) break;
                const e2 = 2 * err;
                if (e2 > -dy) { err -= dy; x0 += sx; }
                if (e2 < dx) { err += dx; y0 += sy; }
            }
        }

        function desenharPolilinha() {
            const validos = getPontosValidos();
            if (validos.length < 2) return;

            // Desenha segmentos
            for (let i = 0; i < validos.length - 1; i++) {
                bresenham(validos[i].x, validos[i].y, validos[i+1].x, validos[i+1].y);
            }

            // Desenha vértices (maiores)
            for (const p of validos) {
                for (let dy = -3; dy <= 3; dy++) {
                    for (let dx = -3; dx <= 3; dx++) {
                        putPixel(p.x + dx, p.y + dy, corVertice);
                    }
                }
            }
        }

        // ---- Canvas ----
        function limpar() {
            ctx.fillStyle = '#0f0f1f';
            ctx.fillRect(0, 0, 400, 400);
            ctx.strokeStyle = '#1a1a3a';
            ctx.lineWidth = 0.5;
            for (let i = 0; i <= 400; i += 40) {
                ctx.beginPath();
                ctx.moveTo(i, 0);
                ctx.lineTo(i, 400);
                ctx.stroke();
                ctx.beginPath();
                ctx.moveTo(0, i);
                ctx.lineTo(400, i);
                ctx.stroke();
            }
        }

        function desenhar() {
            limpar();
            desenharPolilinha();
            atualizarInfo();
        }

        // ---- Gerenciamento de pontos ----
        function adicionarPonto(x, y) {
            if (x === undefined || y === undefined) {
                x = Math.floor(Math.random() * 380) + 10;
                y = Math.floor(Math.random() * 380) + 10;
            }
            pontos.push({ x, y });
            renderizarLista();
            desenhar();
            statusMsg.textContent = `✅ Ponto #${pontos.length} adicionado em (${x}, ${y})`;
        }

        function removerUltimo() {
            if (pontos.length > 4) {
                pontos.pop();
                renderizarLista();
                desenhar();
                statusMsg.textContent = `🗑️ Último ponto removido`;
            } else {
                alert('Mínimo de 4 pontos!');
            }
        }

        function limparPontos() {
            if (pontos.length > 4) {
                if (confirm('Remover todos os pontos? (mínimo 4)')) {
                    const primeiros = pontos.slice(0, 4);
                    pontos = primeiros;
                    renderizarLista();
                    desenhar();
                    statusMsg.textContent = '🗑️ Pontos limpos (mantidos 4)';
                }
            } else {
                alert('Já está no mínimo de 4 pontos!');
            }
        }

        function gerarAleatorio() {
            const numPontos = Math.floor(Math.random() * 6) + 5;
            const novos = [];
            for (let i = 0; i < numPontos; i++) {
                novos.push({
                    x: Math.floor(Math.random() * 380) + 10,
                    y: Math.floor(Math.random() * 380) + 10
                });
            }
            pontos = novos;
            renderizarLista();
            desenhar();
            statusMsg.innerHTML = `🎲 ${numPontos} pontos aleatórios <span style="color:#2ecc71;">gerados</span>!`;
        }

        // ---- Eventos ----
        addPointBtn.addEventListener('click', () => adicionarPonto());
        removeLastBtn.addEventListener('click', removerUltimo);
        clearPointsBtn.addEventListener('click', limparPontos);
        drawBtn.addEventListener('click', () => {
            desenhar();
            statusMsg.textContent = '🔄 Polilinha redesenhada';
        });
        randomBtn.addEventListener('click', gerarAleatorio);

        lineColorInput.addEventListener('input', () => {
            corLinha = lineColorInput.value;
            desenhar();
        });

        vertexColorInput.addEventListener('input', () => {
            corVertice = vertexColorInput.value;
            desenhar();
        });

        // Clique no canvas
        canvas.addEventListener('click', (e) => {
            const rect = canvas.getBoundingClientRect();
            const scaleX = canvas.width / rect.width;
            const scaleY = canvas.height / rect.height;
            const mx = Math.round((e.clientX - rect.left) * scaleX);
            const my = Math.round((e.clientY - rect.top) * scaleY);
            if (mx < 0 || mx >= 400 || my < 0 || my >= 400) return;

            const validos = getPontosValidos();
            let encontrado = false;
            for (let i = 0; i < validos.length; i++) {
                const d = (mx - validos[i].x) ** 2 + (my - validos[i].y) ** 2;
                if (d < 400) {
                    pontos[i].x = mx;
                    pontos[i].y = my;
                    renderizarLista();
                    desenhar();
                    statusMsg.textContent = `📍 Ponto #${i+1} movido para (${mx}, ${my})`;
                    encontrado = true;
                    break;
                }
            }

            if (!encontrado) {
                adicionarPonto(mx, my);
            }
        });

        // Inicialização
        renderizarLista();
        desenhar();
        statusMsg.textContent = '🖱️ Clique no canvas para adicionar/mover pontos';

        window.__state = { pontos };
    })();
</script>

</body>
</html>
